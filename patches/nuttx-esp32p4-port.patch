new file mode 100644
--- /dev/null
+++ b/nuttx/drivers/motor/sa8339.c
+/****************************************************************************
+ * drivers/motor/sa8339.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/* Character driver for the SA8339-based 4-channel DC motor driver module.
+ *
+ * The module exposes a register map over I2C (see include/nuttx/motor/
+ * sa8339.h).  All channel-oriented registers are written/read in a single
+ * I2C transfer: FIXED_PWM and FIXED_SPEED take 4 x int8, ENCODER_TOTAL
+ * takes 16 bytes (4 x int32 little-endian).
+ *
+ * The driver registers a character device (/dev/sa8339 by convention) and
+ * exposes the following ioctl() commands:
+ *
+ *   SA8339_IOC_PWM         int8_t pwm[4]   open-loop PWM, -100..100
+ *   SA8339_IOC_SPEED       int8_t spd[4]   closed-loop speed
+ *   SA8339_IOC_STOP        -               stop all four channels
+ *   SA8339_IOC_MOTOR_TYPE  int             write motor type (0x14)
+ *   SA8339_IOC_ENCODER_POL int             write encoder polarity (0x15)
+ *   SA8339_IOC_READ_ENC    int32_t enc[4]  read accumulated pulses
+ *   SA8339_IOC_RESET_ENC   -               reset encoder counters
+ *   SA8339_IOC_READ_ADC    uint8_t *       read battery ADC sample
+ *   SA8339_IOC_REG_WRITE   regop           raw register write (debug)
+ *   SA8339_IOC_REG_READ    regop           raw register read (debug)
+ */
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <stdint.h>
+#include <string.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <debug.h>
+
+#include <nuttx/fs/fs.h>
+#include <nuttx/kmalloc.h>
+#include <nuttx/mutex.h>
+#include <nuttx/i2c/i2c_master.h>
+#include <nuttx/motor/sa8339.h>
+
+#ifdef CONFIG_MOTOR_SA8339
+
+#ifndef CONFIG_MOTOR_SA8339_I2C_FREQ
+#  define CONFIG_MOTOR_SA8339_I2C_FREQ 400000
+#endif
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct sa8339_dev_s
+{
+  FAR struct i2c_master_s *i2c; /* I2C master interface */
+  uint8_t addr;                 /* 7-bit I2C address */
+  mutex_t lock;                 /* Serializes access */
+  uint32_t freq;                /* I2C bus frequency */
+};
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+/* I2C helpers */
+
+static int sa8339_write_reg(FAR struct sa8339_dev_s *priv, uint8_t reg,
+                            FAR const uint8_t *data, uint8_t len);
+static int sa8339_read_reg(FAR struct sa8339_dev_s *priv, uint8_t reg,
+                           FAR uint8_t *data, uint8_t len);
+
+/* Character driver methods */
+
+static int sa8339_open(FAR struct file *filep);
+static int sa8339_close(FAR struct file *filep);
+static int sa8339_ioctl(FAR struct file *filep, int cmd, unsigned long arg);
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const struct file_operations g_sa8339_fops =
+{
+  sa8339_open,   /* open */
+  sa8339_close,  /* close */
+  NULL,          /* read */
+  NULL,          /* write */
+  NULL,          /* seek */
+  sa8339_ioctl,  /* ioctl */
+  NULL,          /* mmap */
+  NULL,          /* truncate */
+  NULL           /* poll */
+};
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: sa8339_write_reg
+ *
+ * Description:
+ *   Write one or more bytes to a SA8339 register.  The transfer layout is
+ *   [reg][data...] in a single I2C write.
+ *
+ ****************************************************************************/
+
+static int sa8339_write_reg(FAR struct sa8339_dev_s *priv, uint8_t reg,
+                            FAR const uint8_t *data, uint8_t len)
+{
+  struct i2c_config_s config;
+  uint8_t buf[SA8339_MAX_REG_LEN + 1];
+  int ret;
+
+  if (len > SA8339_MAX_REG_LEN)
+    {
+      return -EINVAL;
+    }
+
+  buf[0] = reg;
+  memcpy(&buf[1], data, len);
+
+  config.frequency = priv->freq;
+  config.address   = priv->addr;
+  config.addrlen   = 7;
+
+  ret = i2c_write(priv->i2c, &config, buf, len + 1);
+  if (ret < 0)
+    {
+      i2cerr("SA8339: reg write 0x%02x len=%u failed: %d\n",
+             reg, len, ret);
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: sa8339_read_reg
+ *
+ * Description:
+ *   Read one or more bytes from a SA8339 register.  The transfer layout is
+ *   a single-byte write of the register address followed by a repeated
+ *   start read of `len` bytes.
+ *
+ ****************************************************************************/
+
+static int sa8339_read_reg(FAR struct sa8339_dev_s *priv, uint8_t reg,
+                           FAR uint8_t *data, uint8_t len)
+{
+  struct i2c_config_s config;
+  int ret;
+
+  if (len > SA8339_MAX_REG_LEN)
+    {
+      return -EINVAL;
+    }
+
+  config.frequency = priv->freq;
+  config.address   = priv->addr;
+  config.addrlen   = 7;
+
+  ret = i2c_writeread(priv->i2c, &config, &reg, 1, data, len);
+  if (ret < 0)
+    {
+      i2cerr("SA8339: reg read 0x%02x len=%u failed: %d\n",
+             reg, len, ret);
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: sa8339_open
+ *
+ * Description:
+ *   Open the SA8339 device.
+ *
+ ****************************************************************************/
+
+static int sa8339_open(FAR struct file *filep)
+{
+  FAR struct sa8339_dev_s *priv = filep->f_priv;
+
+  if (priv == NULL)
+    {
+      return -ENODEV;
+    }
+
+  return nxmutex_lock(&priv->lock);
+}
+
+/****************************************************************************
+ * Name: sa8339_close
+ *
+ * Description:
+ *   Close the SA8339 device.
+ *
+ ****************************************************************************/
+
+static int sa8339_close(FAR struct file *filep)
+{
+  FAR struct sa8339_dev_s *priv = filep->f_priv;
+
+  if (priv == NULL)
+    {
+      return -ENODEV;
+    }
+
+  nxmutex_unlock(&priv->lock);
+  return OK;
+}
+
+/****************************************************************************
+ * Name: sa8339_ioctl
+ *
+ * Description:
+ *   Handle SA8339 ioctl commands.
+ *
+ ****************************************************************************/
+
+static int sa8339_ioctl(FAR struct file *filep, int cmd, unsigned long arg)
+{
+  FAR struct sa8339_dev_s *priv = filep->f_priv;
+  FAR struct sa8339_regop_s *regop;
+  int ret = -ENOTTY;
+
+  if (priv == NULL)
+    {
+      return -ENODEV;
+    }
+
+  switch (cmd)
+    {
+      /* Open-loop PWM, arg points to int8_t[4], values -100..100 */
+
+      case SA8339_IOC_PWM:
+        ret = sa8339_write_reg(priv, SA8339_REG_FIXED_PWM,
+                               (FAR const uint8_t *)arg, 4);
+        break;
+
+      /* Closed-loop speed, arg points to int8_t[4] */
+
+      case SA8339_IOC_SPEED:
+        ret = sa8339_write_reg(priv, SA8339_REG_FIXED_SPEED,
+                               (FAR const uint8_t *)arg, 4);
+        break;
+
+      /* Stop all four channels */
+
+      case SA8339_IOC_STOP:
+        {
+          uint8_t zero[4] =
+            {
+              0, 0, 0, 0
+            };
+
+          ret = sa8339_write_reg(priv, SA8339_REG_FIXED_PWM, zero, 4);
+          if (ret >= 0)
+            {
+              ret = sa8339_write_reg(priv, SA8339_REG_FIXED_SPEED, zero, 4);
+            }
+        }
+        break;
+
+      /* Write motor type register (0x14), arg is an int */
+
+      case SA8339_IOC_MOTOR_TYPE:
+        {
+          uint8_t value = (uint8_t)((int)arg & 0xff);
+
+          ret = sa8339_write_reg(priv, SA8339_REG_MOTOR_TYPE, &value, 1);
+        }
+        break;
+
+      /* Write encoder polarity register (0x15), arg is an int */
+
+      case SA8339_IOC_ENCODER_POL:
+        {
+          uint8_t value = (uint8_t)((int)arg & 0xff);
+
+          ret = sa8339_write_reg(priv, SA8339_REG_ENCODER_POL, &value, 1);
+        }
+        break;
+
+      /* Read accumulated encoder pulses, arg points to int32_t[4] */
+
+      case SA8339_IOC_READ_ENC:
+        {
+          FAR int32_t *enc = (FAR int32_t *)arg;
+          uint8_t data[16];
+          int i;
+
+          ret = sa8339_read_reg(priv, SA8339_REG_ENCODER_TOTAL, data, 16);
+          if (ret >= 0)
+            {
+              for (i = 0; i < 4; i++)
+                {
+                  enc[i] = (int32_t)((uint32_t)data[i * 4 + 0] |
+                                     ((uint32_t)data[i * 4 + 1] << 8) |
+                                     ((uint32_t)data[i * 4 + 2] << 16) |
+                                     ((uint32_t)data[i * 4 + 3] << 24));
+                }
+            }
+        }
+        break;
+
+      /* Reset encoder counters (write 16 zero bytes) */
+
+      case SA8339_IOC_RESET_ENC:
+        {
+          uint8_t zero[16] =
+            {
+              0
+            };
+
+          ret = sa8339_write_reg(priv, SA8339_REG_ENCODER_TOTAL, zero, 16);
+        }
+        break;
+
+      /* Read battery ADC sample, arg points to uint8_t */
+
+      case SA8339_IOC_READ_ADC:
+        ret = sa8339_read_reg(priv, SA8339_REG_ADC_BAT,
+                              (FAR uint8_t *)arg, 1);
+        break;
+
+      /* Raw register write, arg points to struct sa8339_regop_s */
+
+      case SA8339_IOC_REG_WRITE:
+        regop = (FAR struct sa8339_regop_s *)arg;
+        if (regop == NULL)
+          {
+            ret = -EINVAL;
+          }
+        else
+          {
+            ret = sa8339_write_reg(priv, regop->reg, regop->data,
+                                   regop->len);
+          }
+        break;
+
+      /* Raw register read, arg points to struct sa8339_regop_s.
+       * reg and len are inputs; data receives the result.
+       */
+
+      case SA8339_IOC_REG_READ:
+        regop = (FAR struct sa8339_regop_s *)arg;
+        if (regop == NULL)
+          {
+            ret = -EINVAL;
+          }
+        else
+          {
+            ret = sa8339_read_reg(priv, regop->reg, regop->data,
+                                  regop->len);
+          }
+        break;
+
+      default:
+        i2cerr("SA8339: unknown ioctl cmd=%d\n", cmd);
+        break;
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: sa8339_register
+ *
+ * Description:
+ *   Register the SA8339 motor driver as a character device.
+ *
+ ****************************************************************************/
+
+int sa8339_register(FAR const char *devpath,
+                    FAR struct i2c_master_s *i2c,
+                    uint8_t addr)
+{
+  FAR struct sa8339_dev_s *priv;
+  int ret;
+
+  DEBUGASSERT(devpath != NULL);
+  DEBUGASSERT(i2c != NULL);
+
+  /* Initialize the device structure */
+
+  priv = (FAR struct sa8339_dev_s *)
+         kmm_zalloc(sizeof(struct sa8339_dev_s));
+  if (priv == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  priv->i2c  = i2c;
+  priv->addr = addr;
+  priv->freq = CONFIG_MOTOR_SA8339_I2C_FREQ;
+  nxmutex_init(&priv->lock);
+
+  /* Register the character driver */
+
+  ret = register_driver(devpath, &g_sa8339_fops, 0666, priv);
+  if (ret < 0)
+    {
+      i2cerr("SA8339: register_driver failed: %d\n", ret);
+      nxmutex_destroy(&priv->lock);
+      kmm_free(priv);
+      return ret;
+    }
+
+  i2cinfo("SA8339: registered %s @ I2C addr 0x%02x\n",
+          devpath, addr);
+  return OK;
+}
+
+#endif /* CONFIG_MOTOR_SA8339 */
+
