+
+if(SRCS)
+  target_sources(arch PRIVATE ${SRCS})
+endif()
+
diff --git a/nuttx/arch/risc-v/src/esp32p4/esp32p4_usleep_shim.c b/nuttx/arch/risc-v/src/esp32p4/esp32p4_usleep_shim.c
new file mode 100644
--- /dev/null
+++ b/nuttx/arch/risc-v/src/esp32p4/esp32p4_usleep_shim.c
+/****************************************************************************
+ * arch/risc-v/src/esp32p4/esp32p4_usleep_shim.c
+ *
+ * openvela contest port: provide nxsched_usleep (NuttX mainline API)
+ * used by esp-hal-3rdparty platform layer; openvela only has nxsig_usleep.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/signal.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int nxsched_usleep(useconds_t usec)
+{
+  return nxsig_usleep(usec);
+}
+
