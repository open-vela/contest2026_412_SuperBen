-
-static int esp_timer_start(struct timer_lowerhalf_s *lower)
-{
-  struct esp_timer_lowerhalf_s *priv = (struct esp_timer_lowerhalf_s *)lower;
-  uint32_t counter_src_hz = 0;
-  uint32_t prescale;
-
