-  if (timer == NULL)
-    {
-      tmrerr("Failed to allocate %d bytes\n", sizeof(*timer));
-
-      return -ENOMEM;
-    }
-
-  timer->callback = args->callback;
-  timer->arg      = args->arg;
-  timer->flags    = HR_TIMER_NOFLAGS;
-  timer->state    = HR_TIMER_IDLE;
